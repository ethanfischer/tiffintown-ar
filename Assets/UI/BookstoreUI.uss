/* Root container */
.root {
    width: 100%;
    height: 100%;
    background-color: #F5F5F5;
    flex-direction: column;
}

/* Search Bar */
.search-bar {
    background-color: white;
    height: 80px;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 15px;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: #E0E0E0;
}

.search-field {
    flex-grow: 1;
    height: 50px;
    margin-right: 15px;
    background-color: #F5F5F5;
    border-radius: 25px;
    border-width: 0;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 16px;
}

.cart-button, .profile-button {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    border-width: 0;
    margin-left: 10px;
    font-size: 20px;
}

.cart-button {
    background-color: #333333;
    color: white;
}

.profile-button {
    background-color: #D4A574;
}

/* Main Content */
.main-content {
    flex-grow: 1;
    flex-direction: column;
}

/* Featured Section */
.featured-section {
    height: 300px;
    background-color: #2C4A3B;
    padding: 30px;
    justify-content: center;
    position: relative;
}

.best-seller-badge {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.featured-title {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    max-width: 70%;
    white-space: normal;
}

.featured-author {
    color: #CCCCCC;
    font-size: 16px;
}

/* Toggle Section */
.toggle-section {
    flex-direction: row;
    padding: 20px;
    background-color: white;
}

.toggle-button {
    height: 40px;
    padding-left: 30px;
    padding-right: 30px;
    border-radius: 20px;
    border-width: 0;
    margin-right: 15px;
    font-size: 16px;
}

.toggle-active {
    background-color: #FF6B35;
    color: white;
}

.toggle-inactive {
    background-color: #E0E0E0;
    color: #666666;
}

/* Trending Header */
.trending-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: white;
}

.section-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #333333;
}

.arrow {
    font-size: 18px;
    color: #666666;
}

/* Trending Books Scroll */
.trending-books-scroll {
    background-color: white;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

.book-card {
    width: 120px;
    margin-right: 15px;
    align-items: center;
}

.book-cover {
    width: 100px;
    height: 140px;
    border-radius: 8px;
    margin-bottom: 8px;
}

.book-cover-red {
    background-color: #8B4A47;
}

.book-cover-blue {
    background-color: #1E3A5F;
}

.book-cover-green {
    background-color: #2C5F41;
}

.book-rating {
    font-size: 12px;
    color: #FFA500;
    -unity-text-align: middle-center;
}

/* Continue Reading */
.continue-reading {
    flex-direction: row;
    align-items: center;
    background-color: #F0F0F0;
    margin: 20px;
    padding: 15px;
    border-radius: 8px;
    position: relative;
}

.continue-book-cover {
    width: 60px;
    height: 80px;
    background-color: #8B4A47;
    border-radius: 4px;
    margin-right: 15px;
}

.continue-info {
    flex-grow: 1;
}

.continue-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #333333;
    margin-bottom: 4px;
}

.continue-author {
    font-size: 14px;
    color: #666666;
    margin-bottom: 8px;
}

.continue-link {
    font-size: 14px;
    color: #FF6B35;
}

.close-button {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 0;
    background-color: transparent;
    color: #999999;
    font-size: 20px;
}

/* Bottom Navigation */
.bottom-nav {
    height: 100px;
    background-color: white;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: #E0E0E0;
    padding-top: 10px;
    padding-bottom: 10px;
}

.nav-button {
    flex-grow: 1;
    border-width: 0;
    background-color: transparent;
    font-size: 12px;
    color: #999999;
    -unity-text-align: middle-center;
    white-space: normal;
    padding-top: 8px;
    padding-bottom: 8px;
}

.nav-active {
    color: #FF6B35;
}
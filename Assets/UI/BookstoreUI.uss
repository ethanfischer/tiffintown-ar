/* Root container */
.root {
    width: 100%;
    height: 100%;
    background-color: #F5F5F5;
    flex-direction: column;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Search Bar */
.search-bar {
    background-color: white;
    height: 10%;
    min-height: 10%;
    flex-direction: row;
    align-items: center;
    padding-left: 5%;
    padding-right: 5%;
    padding-top: 1%;
    padding-bottom: 1%;
    border-bottom-width: 1;
    border-bottom-color: #E0E0E0;
    flex-shrink: 0;
}

.search-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 80%;
    margin-right: 3%;
    background-color: #F5F5F5;
    border-radius: 50%;
    padding-left: 4%;
    padding-right: 4%;
}

.search-icon {
    color: #999999;
    font-size: 100%;
    margin-right: 2%;
}

.search-field {
    flex-grow: 1;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    font-size: 100%;
    margin: 0;
    padding: 0;
}

.cart-button, .profile-button {
    width: 80%;
    height: 80%;
    min-width: 80%;
    min-height: 80%;
    border-radius: 50%;
    border-width: 0;
    margin-left: 2%;
    font-size: 100%;
}

.cart-button {
    background-color: #333333;
    color: white;
}

.profile-button {
    background-color: #D4A574;
}

/* Main Content */
.main-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    height: auto;
    min-height: 0;
}

/* Featured Section */
.featured-section {
    height: 40%;
    min-height: 40%;
    max-height: 40%;
    background-color: #2C4A3B;
    padding: 5%;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
}

.best-seller-badge {
    color: white;
    font-size: 80%;
    -unity-font-style: bold;
    margin-bottom: 2%;
}

.featured-title {
    color: white;
    font-size: 150%;
    -unity-font-style: bold;
    margin-bottom: 2%;
    max-width: 70%;
    white-space: normal;
}

.featured-author {
    color: #CCCCCC;
    font-size: 100%;
}

/* Toggle Section */
.toggle-section {
    flex-direction: row;
    padding: 2% 5%;
    background-color: white;
    height: 8%;
    min-height: 8%;
    align-items: center;
    flex-shrink: 0;
}

.toggle-button {
    height: 80%;
    padding-left: 8%;
    padding-right: 8%;
    border-radius: 50%;
    border-width: 0;
    margin-right: 3%;
    font-size: 100%;
}

.toggle-active {
    background-color: #FF6B35;
    color: white;
}

.toggle-inactive {
    background-color: #E0E0E0;
    color: #666666;
}

/* Trending Header */
.trending-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 2% 5%;
    background-color: white;
    height: 5%;
    min-height: 5%;
    flex-shrink: 0;
}

.section-title {
    font-size: 110%;
    -unity-font-style: bold;
    color: #333333;
}

.arrow {
    font-size: 110%;
    color: #666666;
}

/* Trending Books Scroll */
.trending-books-scroll {
    background-color: white;
    padding-bottom: 2%;
    padding-left: 5%;
    padding-right: 5%;
    height: 18%;
    min-height: 18%;
    max-height: 18%;
    flex-shrink: 0;
}

.book-card {
    width: 25%;
    margin-right: 3%;
    align-items: center;
    flex-shrink: 0;
}

.book-cover {
    width: 80%;
    height: 80%;
    border-radius: 5%;
    margin-bottom: 2%;
}

.book-cover-red {
    background-color: #8B4A47;
}

.book-cover-blue {
    background-color: #1E3A5F;
}

.book-cover-green {
    background-color: #2C5F41;
}

.book-cover-orange {
    background-color: #D67032;
}

.book-rating {
    font-size: 75%;
    color: #FFA500;
    -unity-text-align: middle-center;
}

/* Continue Reading */
.continue-reading {
    flex-direction: row;
    align-items: center;
    background-color: #F0F0F0;
    margin: 2% 3%;
    padding: 2% 3%;
    border-radius: 5%;
    height: 8%;
    min-height: 8%;
    position: relative;
    flex-shrink: 0;
}

.continue-book-cover {
    width: 15%;
    height: 80%;
    background-color: #8B4A47;
    border-radius: 5%;
    margin-right: 3%;
}

.continue-info {
    flex-grow: 1;
}

.continue-title {
    font-size: 100%;
    -unity-font-style: bold;
    color: #333333;
    margin-bottom: 1%;
}

.continue-author {
    font-size: 85%;
    color: #666666;
    margin-bottom: 2%;
}

.continue-link {
    font-size: 85%;
    color: #FF6B35;
}

.close-button {
    position: absolute;
    top: 2%;
    right: 2%;
    width: 8%;
    height: 25%;
    min-width: 8%;
    min-height: 25%;
    border-radius: 50%;
    border-width: 0;
    background-color: transparent;
    color: #999999;
    font-size: 120%;
}

/* Bottom Navigation */
.bottom-nav {
    height: 5%;
    min-height: 5%;
    background-color: white;
    flex-direction: row;
    border-top-width: 1;
    border-top-color: #E0E0E0;
    padding-top: 1%;
    padding-bottom: 1%;
    flex-shrink: 0;
}

.nav-button {
    flex-grow: 1;
    border-width: 0;
    background-color: transparent;
    font-size: 75%;
    color: #999999;
    -unity-text-align: middle-center;
    white-space: normal;
    padding-top: 2%;
    padding-bottom: 2%;
}

.nav-active {
    color: #FF6B35;
}
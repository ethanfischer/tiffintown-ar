/* Book Detail Root */
.book-detail-root {
    width: 100%;
    height: 100%;
    max-width: 500px;
    background-color: #F5F5F5;
    flex-direction: column;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-shrink: 0;
}

/* Header */
.book-detail-header {
    height: 10%;
    min-height: 10%;
    max-height: 10%;
    background-color: white;
    padding: 2% 5%;
    justify-content: center;
    align-items: flex-start;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: #E0E0E0;
}

.back-button {
    background-color: transparent;
    border-width: 0;
    color: #FF6B35;
    font-size: 110%;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}

/* Content Area */
.book-detail-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: white;
    padding: 5%;
}

/* Book Cover Container */
.book-cover-container {
    align-items: center;
    justify-content: center;
    height: 40%;
    min-height: 40%;
    max-height: 40%;
    margin-bottom: 5%;
    flex-shrink: 0;
}

.book-cover-large {
    width: 60%;
    height: 90%;
    max-width: 200px;
    max-height: 300px;
    border-radius: 5%;
    background-color: #8B4A47;
    flex-shrink: 0;
}

/* Book Info */
.book-info {
    flex-direction: column;
    margin-bottom: 8%;
    flex-shrink: 0;
}

.book-title {
    font-size: 150%;
    -unity-font-style: bold;
    color: #333333;
    margin-bottom: 2%;
    white-space: normal;
}

.book-author {
    font-size: 110%;
    color: #666666;
    margin-bottom: 2%;
}

.book-price {
    font-size: 130%;
    -unity-font-style: bold;
    color: #FF6B35;
    margin-bottom: 4%;
}

.book-description {
    font-size: 100%;
    color: #333333;
    white-space: normal;
    line-height: 120%;
}

/* Actions */
.book-actions {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding: 3% 5%;
    background-color: white;
    border-top-width: 1px;
    border-top-color: #E0E0E0;
}

.buy-button {
    width: 80%;
    max-width: 200px;
    height: 50px;
    max-height: 50px;
    background-color: #FF6B35;
    color: white;
    font-size: 110%;
    -unity-font-style: bold;
    border-radius: 5%;
    border-width: 0;
    flex-shrink: 0;
}